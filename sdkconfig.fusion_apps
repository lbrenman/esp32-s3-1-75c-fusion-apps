# ---- fusion_apps additions (appended to Waveshare's sdkconfig.defaults) ----
# Fonts used by the UI (most are already enabled above; listed so nothing is missing)
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_44=y
# Widgets used by Settings and the text editor
CONFIG_LV_USE_KEYBOARD=y
CONFIG_LV_USE_TEXTAREA=y
CONFIG_LV_USE_SWITCH=y
CONFIG_LV_USE_SLIDER=y
CONFIG_LV_USE_SPINNER=y
CONFIG_LV_USE_THEME_DEFAULT=y
# TLS for wss://: the embedded server chain, or the built-in CA bundle for other hosts
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
# Keep internal RAM free for the display: let TLS, Wi-Fi and lwIP use PSRAM
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# Keep internal RAM available for the display's DMA transfers. Waveshare's defaults reserve only
# 4 KB, so a full-screen repaint can fail with "Draw bitmap failed: ESP_ERR_NO_MEM".
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=49152
# Voice chat wake word (ESP-SR): only the "Jarvis" model, no speech-command models
CONFIG_SR_WN_WN9_JARVIS_TTS=y
CONFIG_SR_MN_CN_NONE=y
CONFIG_SR_MN_EN_NONE=y
CONFIG_SR_NSN_WEBRTC=y
CONFIG_SR_VADN_WEBRTC=y
# Free internal RAM for the display and the wake word. On the S3, code kept in IRAM comes out of
# the same internal SRAM as the heap, so moving it to flash/PSRAM gives the heap more room.
# The Wi-Fi ones cost a little throughput, which doesn't matter for a 300 KB WAV upload.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_RINGBUF_PLACE_FUNCTIONS_INTO_FLASH=y

# Translator: Arabic letter joining and right-to-left text (LVGL)
CONFIG_LV_USE_BIDI=y
CONFIG_LV_BIDI_DIR_AUTO=y
CONFIG_LV_USE_ARABIC_PERSIAN_CHARS=y
