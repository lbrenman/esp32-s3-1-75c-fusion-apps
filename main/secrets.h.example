#pragma once
// Copy this file to secrets.h and fill in your values.
// secrets.h is gitignored. Do not commit it or paste it anywhere.
//
// These are the FIRST-BOOT defaults. After that you can change Wi-Fi in Settings and the
// server URL / API key in Voice chat (swipe up); the device saves those changes in flash.
// Settings > Reset settings goes back to the values in this file.

// Wi-Fi (ESP32-S3 supports 2.4 GHz networks only)
#define WIFI_SSID      "your-2.4GHz-network"
#define WIFI_PASSWORD  "your-wifi-password"

// Voice server. The default URL is wss://WS_HOST:WS_PORT WS_PATH and the client adds
//   ?x-api-key=WS_API_KEY&conversationId=<random uuid>
// The build fetches main/server_ca.pem from WS_HOST:WS_PORT.
#define WS_HOST        "axway-appc-se-design.sandbox.fusion.services.axway.com"
#define WS_PORT        4443
#define WS_PATH        "/ws/speech"
#define WS_API_KEY     "your-api-key-here"

// Stocks app: your FusionStockWatchListMCP server (Streamable HTTP endpoint) and its x-api-key.
// See https://github.com/lbrenman/Amplify-Fusion-Stock-Watch-List-MCP
// If it's on WS_HOST, the device checks it with main/server_ca.pem; any other host is checked
// against ESP-IDF's built-in CA bundle.
#define STOCKS_MCP_URL      "https://your-fusion-host:4443/FusionStockWatchListMCP"
#define STOCKS_MCP_API_KEY  "your-mcp-api-key"
